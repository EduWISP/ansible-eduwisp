# {{ ansible_managed }}
upstream eduwisp_app {
    server unix:/run/eduwisp/gunicorn.sock fail_timeout=0;
}

{% set intestazioni %}
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
{% endset %}

{% set proxy %}
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass http://eduwisp_app;
{% endset %}

{% set reti_admin %}
{% if not eduwisp_tls %}
{% for rete in eduwisp_admin_networks %}
        allow {{ rete }};
{% endfor %}
        deny all;
{% endif %}
{% endset %}

{% set applicazione %}
    location /static/ {
        alias {{ eduwisp_home }}/static/;
        expires 7d;
    }
    # Registrazione dei dispositivi: limite tollerante (scuole dietro NAT).
    location = /api/protocol/v0/enroll {
        limit_req zone=eduwisp_enroll burst={{ eduwisp_ratelimit_enroll_burst }} nodelay;
{{ proxy }}
    }
    # Accesso all'amministrazione: limite contro i tentativi di indovinare la password.
    location = /admin/login/ {
        limit_req zone=eduwisp_login burst={{ eduwisp_ratelimit_login_burst }} nodelay;
{{ reti_admin }}
{{ proxy }}
    }
    location / {
{{ proxy }}
    }
{% endset %}

{% if eduwisp_tls %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ eduwisp_domains | join(' ') }};
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ eduwisp_domains | join(' ') }};

    ssl_certificate {{ eduwisp_tls_certificate }};
    ssl_certificate_key {{ eduwisp_tls_certificate_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
{{ intestazioni }}
{{ applicazione }}
}
{% else %}
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ eduwisp_domains | join(' ') }};
{{ intestazioni }}
    # Senza TLS l'amministrazione è raggiungibile solo dalle reti locali.
    location /admin/ {
{{ reti_admin }}
{{ proxy }}
    }
{{ applicazione }}
}
{% endif %}
