# {{ ansible_managed }}
set daemon 60
set mailserver {{ eduwisp_smtp_host }} port {{ eduwisp_smtp_port }}
    username "{{ eduwisp_smtp_user }}" password "{{ eduwisp_smtp_password }}"
    using tls
set mail-format {
  from: {{ eduwisp_smtp_from }}
  subject: [EduWISP {{ ansible_fqdn }}] $SERVICE: $EVENT
  message: $DATE — $SERVICE: $DESCRIPTION
}
set alert {{ eduwisp_alert_email }} not on { instance, action }
set httpd unixsocket /run/monit.sock
    allow root

{% for servizio in ['nginx', 'eduwisp', 'eduwisp-worker', 'eduwisp-beat', 'postgresql', 'valkey-server', 'suricata', 'fail2ban', 'nftables', 'auditd'] %}
check program servizio-{{ servizio }} with path "/usr/bin/systemctl is-active --quiet {{ servizio }}"
    if status != 0 for 2 cycles then alert
{% endfor %}

check filesystem disco-radice with path /
    if space usage > {{ eduwisp_monit_disk_limit }}% then alert
    if inode usage > 80% then alert

check system {{ ansible_hostname }}
    if memory usage > {{ eduwisp_monit_memory_limit }}% for 5 cycles then alert
    if loadavg (5min) > {{ ansible_processor_vcpus * 2 }} for 5 cycles then alert

check host sito-{{ eduwisp_domains[0] }} with address {{ eduwisp_domains[0] }}
    if failed port 443 protocol https request "/admin/login/" status = 200
       and certificate valid > 15 days for 2 cycles then alert
