# {{ ansible_managed }}
[Unit]
Description=Prova di ripristino dei backup di EduWISP
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/eduwisp-backup-verify
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=false
NoNewPrivileges=true
