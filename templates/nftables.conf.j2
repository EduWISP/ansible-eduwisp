#!/usr/sbin/nft -f
# {{ ansible_managed }} — firewall EduWISP
flush ruleset

table inet filter {
  set ssh_limitati_v4 { type ipv4_addr; flags dynamic, timeout; timeout 1m; }
  set ssh_limitati_v6 { type ipv6_addr; flags dynamic, timeout; timeout 1m; }

  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    ct state invalid drop
    ct state established,related accept

    # ICMP necessario (IPv6 non funziona senza Neighbor Discovery)
    meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    meta l4proto icmp icmp type { destination-unreachable, time-exceeded, parameter-problem, echo-request } limit rate 10/second accept

    # SSH con limite di nuove connessioni per indirizzo
    tcp dport {{ eduwisp_ssh_port }} ct state new add @ssh_limitati_v4 { ip saddr limit rate 10/minute } accept
    tcp dport {{ eduwisp_ssh_port }} ct state new add @ssh_limitati_v6 { ip6 saddr limit rate 10/minute } accept

    tcp dport { 80, 443 } accept

    limit rate 5/minute log prefix "nft-scartato: " level info
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
