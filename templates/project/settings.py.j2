from pathlib import Path

SECRET_KEY = Path("/etc/eduwisp/secret_key").read_text().strip()
DEBUG = False
ALLOWED_HOSTS = {{ eduwisp_domains | to_json }}
CSRF_TRUSTED_ORIGINS = {{ eduwisp_domains | map('regex_replace', '^', 'https://') | list | to_json }}

INSTALLED_APPS = [
{% if eduwisp_health %}
    "eduwisp_utils",
{% endif %}
    "eduwisp_users",
    "eduwisp_school",
    "eduwisp_devices",
{% if eduwisp_portal %}
    "eduwisp_audit",
{% endif %}
{% if eduwisp_apps %}
    "eduwisp_apps",
{% endif %}
{% if eduwisp_portal %}
    "eduwisp_portal",
{% endif %}
    "rest_framework",
    "django.contrib.admin",
    "django.contrib.auth",
    "django.contrib.contenttypes",
    "django.contrib.sessions",
    "django.contrib.messages",
    "django.contrib.staticfiles",
]
MIDDLEWARE = [
    "django.middleware.security.SecurityMiddleware",
    "django.contrib.sessions.middleware.SessionMiddleware",
    "django.middleware.common.CommonMiddleware",
    "django.middleware.csrf.CsrfViewMiddleware",
    "django.contrib.auth.middleware.AuthenticationMiddleware",
    "django.contrib.messages.middleware.MessageMiddleware",
    "django.middleware.clickjacking.XFrameOptionsMiddleware",
{% if eduwisp_portal %}
    # «Vedi come» in sola lettura (ADR-0018): dopo sessioni e autenticazione.
    "eduwisp_portal.middleware.SolaLetturaVediComeMiddleware",
{% endif %}
]
ROOT_URLCONF = "eduwisp_server.urls"
WSGI_APPLICATION = "eduwisp_server.wsgi.application"
TEMPLATES = [
    {
        "BACKEND": "django.template.backends.django.DjangoTemplates",
        "APP_DIRS": True,
        "OPTIONS": {
            "context_processors": [
                "django.template.context_processors.request",
                "django.contrib.auth.context_processors.auth",
                "django.contrib.messages.context_processors.messages",
                "eduwisp_users.context_processors.environment",
{% if eduwisp_portal %}
                "eduwisp_portal.context_processors.portale",
{% endif %}
            ]
        },
    }
]
DATABASES = {
    "default": {
        "ENGINE": "django.db.backends.postgresql",
        "NAME": "{{ eduwisp_db_name }}",
        "CONN_MAX_AGE": 60,
    }
}
AUTH_PASSWORD_VALIDATORS = [
    {"NAME": "django.contrib.auth.password_validation.UserAttributeSimilarityValidator"},
    {"NAME": "django.contrib.auth.password_validation.MinimumLengthValidator", "OPTIONS": {"min_length": 12}},
    {"NAME": "django.contrib.auth.password_validation.CommonPasswordValidator"},
    {"NAME": "django.contrib.auth.password_validation.NumericPasswordValidator"},
]
LANGUAGE_CODE = "it"
TIME_ZONE = "Europe/Rome"
USE_I18N = True
USE_TZ = True
STATIC_URL = "static/"
STATIC_ROOT = "{{ eduwisp_home }}/static"
DEFAULT_AUTO_FIELD = "django.db.models.BigAutoField"
{% if eduwisp_apps %}
# App consentite nella policy dei dispositivi (ADR-0019).
EDUWISP_POLICY_PROVIDERS = ["eduwisp_apps.policy.provide"]
{% endif %}
{% if eduwisp_portal %}
LOGIN_URL = "eduwisp_portal:accedi"
LOGIN_REDIRECT_URL = "/"
{% endif %}

# Sicurezza
SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
SESSION_COOKIE_HTTPONLY = True
SESSION_COOKIE_AGE = 8 * 3600
SESSION_COOKIE_SECURE = {{ 'True' if eduwisp_tls | default(false) else 'False' }}
CSRF_COOKIE_SECURE = SESSION_COOKIE_SECURE
X_FRAME_OPTIONS = "DENY"

LOGGING = {
    "version": 1,
    "disable_existing_loggers": False,
    "handlers": {"console": {"class": "logging.StreamHandler"}},
    "root": {"handlers": ["console"], "level": "INFO"},
}

# Celery con Valkey (ADR-0016): solo socket Unix locale, password in /etc/eduwisp.
_VALKEY_PASSWORD = Path("/etc/eduwisp/valkey_password").read_text().strip()
CELERY_BROKER_URL = f"redis+socket://:{_VALKEY_PASSWORD}@/run/valkey/valkey-server.sock"
CELERY_TASK_IGNORE_RESULT = True
CELERY_TASK_ACKS_LATE = True
CELERY_WORKER_PREFETCH_MULTIPLIER = 1
CELERY_TASK_TIME_LIMIT = 600
CELERY_TIMEZONE = TIME_ZONE
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP = True
CELERY_BEAT_SCHEDULE = {}

# EduWISP
EDUWISP_SERVER_URL = "https://{{ eduwisp_domains[0] }}"
EDUWISP_ENVIRONMENT_NOTICE = {{ eduwisp_environment_notice | to_json }}
EDUWISP_POLL_INTERVAL_SECONDS = {{ eduwisp_poll_interval_seconds }}
EDUWISP_ANDROID_DPC = {{ eduwisp_android_dpc | to_json }}
